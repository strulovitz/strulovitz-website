# AI PANORAMA SECRETS - EXAMPLE FILE
# ==================================
#
# WHAT THIS FILE IS
# A list of every password and key the project needs, with FAKE values.
# This file IS committed to git on purpose, so that any future agent knows
# exactly what has to exist.
#
# WHAT TO DO WITH IT
# Copy it to a file named ".env" in the same folder, then put the real values
# in that copy. The real ".env" is never committed and never shown in chat.
#
#     cp .env.example .env
#     chmod 600 .env
#
# THE RULES (bible/part-07.md section 7.4)
# 1. Real values never appear in git, in logs, in error messages, in Telegram
#    messages, or in a prompt sent to any AI model.
# 2. The FTP password for the website lives ONLY inside Nir's FileZilla.
#    No agent ever gets it, because no agent is ever allowed to touch the
#    live website (bible/part-01.md 1.9). That is a safety feature.
# 3. A paper or USB copy of the real values lives in a drawer Nir trusts,
#    for the day both computers are gone (bible/part-12.md 12.2.5).


# --- OPENROUTER: the one place all AI text work is bought ---
# Two SEPARATE keys on purpose. If one leaks, we cancel it without stopping
# the other, and each has its own spending limit set on OpenRouter's website.
# Get them from: https://openrouter.ai/  (Keys section)

# Used by the automatic pipeline (writing articles, checking facts).
OPENROUTER_API_KEY_PIPELINE=sk-or-v1-REPLACE-ME-pipeline-key

# Used by the interactive helpers (OpenCode sessions like this one).
OPENROUTER_API_KEY_AGENT=sk-or-v1-REPLACE-ME-agent-key

# A hard ceiling in US dollars per day. The pipeline stops and asks Nir on
# Telegram rather than quietly spending more (bible/part-07.md 7.5).
OPENROUTER_DAILY_BUDGET_USD=5.00


# --- TELEGRAM: the control room ---
# The private bot that asks Nir for approvals and reports problems.
# Created by talking to @BotFather inside Telegram.
TELEGRAM_BOT_TOKEN=123456789:REPLACE-ME-with-the-real-bot-token

# Nir's own numeric Telegram user id. The bot answers NOBODY else and stays
# silent for strangers (bible/part-07.md 7.8.1). Find it by messaging
# @userinfobot inside Telegram.
TELEGRAM_OWNER_USER_ID=000000000

# The public read-only channel where the weekly digest is posted.
# Different from the private control bot above.
TELEGRAM_PUBLIC_CHANNEL=@replace_me_channel_name


# --- NEO4J: the database that remembers everything, on ATLAS only ---
# Neo4j is reachable only from this computer and the private Tailscale
# network. It is never exposed to the internet (bible/part-07.md 7.6.1).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE-ME-with-a-long-random-password

# IMPORTANT DISK NOTE. The system partition on Atlas has only about 46 GB
# free, while /home has 1.7 TB. The database will grow for years, so its
# files MUST live under /home. Never let it default into /var.
NEO4J_DATA_DIR=/home/nir/ai-panorama-data/neo4j
NEO4J_BACKUP_DIR=/home/nir/ai-panorama-data/backups


# --- THE WEBSITE SERVER (Dreamhost) ---
# Recorded here for documentation only. The password is NOT stored here and
# NOT stored anywhere on disk. It lives in Nir's FileZilla, by design.
FTP_HOST=REPLACE-ME.dreamhost.com
FTP_USER=REPLACE-ME
# FTP_PASSWORD is deliberately absent. Do not add it. See rule 2 above.
FTP_REMOTE_WEB_ROOT=/home/REPLACE-ME/www.strulovitz.org
FTP_REMOTE_PRIVATE_BACKUP_DIR=/home/REPLACE-ME/private-backups


# --- THE TWO HOME MACHINES (names used in every log and message) ---
# ATLAS is the desktop: the database and the factory.
# FORGE is the laptop: the graphics card, images, and transcription.
MACHINE_NAME=atlas
FORGE_TAILSCALE_HOST=forge
ATLAS_TAILSCALE_HOST=atlas
