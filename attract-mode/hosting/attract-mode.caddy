# ATTRACT MODE -- port 8084: Moodle, plus our own plain files (Part 01, 1.4).
#
# One import line in hosting/Caddyfile pulls this in (Part 01, 1.9, item 6).
# Caddy reads import paths relative to the Caddyfile's own folder, so the path
# starts with "..".
#
# THE PORTS ARE THE BIBLE'S: 8081 the old site and pre; 8082 learnime.com;
# 8083 peaktogether.me; 8084 Attract Mode. "pre" is the tunnel at 8081 and
# needs no door here.

:8084 {
	bind 127.0.0.1

	handle /hosted-by {
		header Cache-Control "no-store"
		respond "Served by {system.hostname} (Attract Mode / Moodle)" 200
	}

	@hidden path_regexp hidden "(^|/)[.]"
	respond @hidden 404
	@rootDocs path_regexp rootDocs "^/[^/]+[.]md$"
	respond @rootDocs 404

	# Our own plain files, handed back by Caddy before Moodle sees the request
	# (Part 01, 1.4). Written only by "am publish"; never edited by hand.
	handle_path /am/* {
		root * {$HOME}/strulovitz-website/attract-mode/public
		file_server
	}

	# Everything else is Moodle: its public folder, PHP running as Nir, and
	# anything matching no file goes to Moodle's front controller (Part 08,
	# 8.5). MEASURED on 2026-11-28: r.php answers 404 for "/", while
	# public/index.php answers 303 to the login page -- so index.php is the
	# fallback, exactly as Moodle's own web-server examples do it.
	root * /var/www/moodle/public
	encode gzip
	php_fastcgi unix//run/php/php8.3-fpm-attract.sock {
		try_files {path} {path}/index.php /index.php
	}
	file_server
}
