#!/usr/bin/env bash
set -euo pipefail

for service in site-caddy site-tunnel site-nosleep; do
    printf '%s: %s\n' "$service" "$(systemctl --user is-active "$service.service" || true)"
done
for port in 8081 8082 8083; do
    printf 'Local website at http://127.0.0.1:%s/: ' "$port"
    curl -sI --max-time 5 -o /dev/null -w 'HTTP %{http_code}\n' "http://127.0.0.1:$port/" || true
done
