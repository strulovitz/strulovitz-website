#!/usr/bin/env bash
set -euo pipefail

printf 'REMINDER: run sites-off on the OTHER computer first. Never host from both at the same time (their strulovitz build versions differ, which would break pages).\n'

repo="$HOME/strulovitz-website"
token="$HOME/.config/site-hosting/tunnel-token"

if [[ ! -s "$token" ]]; then
    printf 'The Cloudflare tunnel token is missing. Nothing was started.\n'
    printf 'When the tunnel is ready, put its token in %s (mode 600).\n' "$token"
    exit 1
fi
if [[ "$(stat -c %a "$token")" != 600 ]]; then
    printf 'The tunnel token must have permission 600. Nothing was started.\n'
    exit 1
fi
if ! command -v cloudflared >/dev/null 2>&1; then
    printf 'cloudflared is not installed yet. Nothing was started.\n'
    exit 1
fi

# EVERY repository that the Caddyfile serves from. A website that is not on this
# computer, or is not up to date, is invisible to visitors while this computer
# hosts (the desktop and the laptop take turns). So each one is pulled, or cloned
# if it is missing. A problem prints a loud warning but the other sites still start.
problems=()
sync_repo() {
    local name="$1" dir="$HOME/$1"
    if [[ -d "$dir/.git" ]]; then
        printf 'Checking GitHub updates for %s...\n' "$name"
        git -C "$dir" pull --ff-only || { printf '!!! WARNING: %s could not be updated; serving the version already on this computer.\n' "$name"; problems+=("$name (pull failed)"); }
    elif [[ ! -e "$dir" ]]; then
        printf 'Downloading %s from GitHub...\n' "$name"
        git clone "https://github.com/strulovitz/$name.git" "$dir" || { printf '!!! WARNING: %s could not be downloaded; its pages will be missing.\n' "$name"; problems+=("$name (download failed)"); }
    else
        printf '!!! WARNING: %s exists but is not a git clone.\n' "$dir"; problems+=("$name (not a git clone)")
    fi
}
for name in strulovitz-website Anime peaktogether-website second-opinion demoscene-museum crystal-balls; do
    sync_repo "$name"
done

# The main website is built locally from site/ into exports/ (not in git). Rebuild
# whenever the source of the build is newer than the stamp left by the last build,
# no matter who pulled it (a hand-made "git pull" must not leave an old build).
stamp="$repo/exports/.built-from"
want=$(git -C "$repo" log -1 --format=%H -- site ops/build-export.py)
if [[ ! -f "$repo/exports/pointer.json" || "$(cat "$stamp" 2>/dev/null)" != "$want" ]]; then
    printf 'Building the updated Strulovitz website locally...\n'
    python3 "$repo/ops/build-export.py"
    printf '%s\n' "$want" > "$stamp"
fi

version=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["live"])' "$repo/exports/pointer.json")
if [[ ! -d "$repo/exports/$version" ]]; then
    printf 'The website build is missing: %s\n' "$version"
    exit 1
fi
ln -sfnT "$version" "$repo/exports/current"

# Second Opinion (https://www.strulovitz.org/2nd-opinion/) is served straight
# from its own repository: exports/2nd-opinion is a link to ~/second-opinion/site
# (the clone itself was brought up to date above).
so="$HOME/second-opinion"
if [[ -d "$so/site" && ! -e "$repo/exports/2nd-opinion" ]]; then
    ln -s "$so/site" "$repo/exports/2nd-opinion"
fi

printf 'Starting the local websites, tunnel, and keep-awake service...\n'
systemctl --user start site-caddy.service site-nosleep.service site-tunnel.service
printf 'Websites started. Checking every menu link and every served folder (sites-check)...\n'
sleep 3
"$(dirname "$0")/sites-check" || printf '!!! sites-check found problems (see above). Do not tell anyone the sites work yet.\n'
if (( ${#problems[@]} )); then
    printf '!!! These repositories had problems while updating: %s\n' "${problems[*]}"
fi
printf 'Run sites-status to see the services.\n'
